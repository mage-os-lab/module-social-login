<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="MageOS\SocialLogin\Model\ProviderPool">
        <arguments>
            <argument name="providers" xsi:type="array">
                <item name="google" xsi:type="object">MageOS\SocialLogin\Model\Provider\Google</item>
                <item name="facebook" xsi:type="object">MageOS\SocialLogin\Model\Provider\Facebook</item>
                <item name="linkedin" xsi:type="object">MageOS\SocialLogin\Model\Provider\LinkedIn</item>
                <item name="instagram" xsi:type="object">MageOS\SocialLogin\Model\Provider\Instagram</item>
            </argument>
        </arguments>
    </type>
</config>
